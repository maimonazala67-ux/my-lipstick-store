{
  "name": "luxelips-ecommerce",
  "version": "0.1.0",
  "description": "Premium luxury lipstick e-commerce platform with AR virtual try-on",
  "private": true,
  "license": "Proprietary",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev:backend": "tsx watch src/server/app.ts",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc src/server --outDir dist/server",
    "build:frontend": "vite build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:ar": "jest --testPathPattern=ar",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "ts-node src/server/database/seeds.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "start": "node dist/server/app.js",
    "validate": "npm run type-check && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "express": "^4.18.2",
    "prisma": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "typescript": "^5.0.0",
    "dotenv": "^16.3.1",
    "axios": "^1.4.0",
    "stripe": "^12.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "redis": "^4.6.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-validator": "^7.0.0",
    "nodemailer": "^6.9.0",
    "winston": "^3.10.0",
    "uuid": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "@reduxjs/toolkit": "^1.9.0",
    "react-redux": "^8.1.0",
    "zustand": "^4.4.0",
    "tailwindcss": "^3.3.0",
    "@headlessui/react": "^1.7.0",
    "lucide-react": "^0.263.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "three": "^r128.0.0",
    "face-api.js": "^0.22.2",
    "@tensorflow/tfjs": "^4.0.0",
    "@tensorflow-models/coco-ssd": "^2.2.0",
    "canvas": "^2.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/three": "^r128.0.0",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^5.16.0",
    "@playwright/test": "^1.40.0",
    "vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "tsx": "^3.12.0"
  }
}
