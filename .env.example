# Environment Configuration Template - LuxeLips
# Copy this file to .env and fill in your actual values

# ====== APPLICATION ======
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
BRAND_NAME=LuxeLips

# ====== DATABASE ======
DATABASE_URL=postgresql://user:password@localhost:5432/luxelips_db
DATABASE_LOG=query,info
DATABASE_SLOW_QUERY_LOG_TIME=500

# ====== REDIS CACHE ======
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ====== JWT AUTH ======
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRATION=604800

# ====== SECURITY ======
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====== AR FEATURES ======
ENABLE_AR_TRYOM=true
AR_MODEL_VERSION=1.0
FACE_API_MODEL_PATH=/models/face-api
LIPSTICK_SHADE_DATABASE_PATH=/models/shades

# ====== STRIPE PAYMENT ======
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ====== EMAIL SERVICE ======
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@luxelips.com
EMAIL_FROM_NAME=LuxeLips

# ====== AWS SERVICES ======
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA....................
AWS_SECRET_ACCESS_KEY=wJa...........................
AWS_S3_BUCKET=luxelips-prod
AWS_CLOUDFRONT_DOMAIN=d123456.cloudfront.net

# ====== MONITORING & LOGGING ======
LOG_LEVEL=info
DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxxxxxxx

# ====== GOOGLE ANALYTICS ======
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXXXXXX

# ====== SOCIAL AUTH (PHASE 2) ======
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# ====== FEATURE FLAGS ======
ENABLE_AR_TRYOM=true
ENABLE_VIP_PROGRAM=false
ENABLE_SUBSCRIPTION=false
ENABLE_TUTORIALS=false
MOCK_STRIPE_PAYMENTS=false
MOCK_EMAIL_DELIVERY=false
